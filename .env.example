# Daeroom Cloud (PostgreSQL + MinIO S3)
DAEROOM_URL="https://apiv1.daeroom.my.id"
DAEROOM_API_KEY="your_daeroom_api_key"
DAEROOM_READONLY_KEY="your_daeroom_readonly_key"
NEXT_PUBLIC_S3_URL="https://s3.daeroom.my.id"
DAEROOM_S3_BUCKET="webkonser-assets"
DB_MODE="postgres"

# Mandiri Private Gateway (MPG) - QRIS Dinamis
MPG_GATEWAY_URL="https://paymentgateway.daeroom.my.id"
MPG_API_KEY="your_mpg_api_key"
MPG_WEBHOOK_SECRET="your_mpg_webhook_secret"

# Daeroom Mail & Telegram Gateway (OTP Email & Telegram Admin Approval)
DAEROOM_MAIL_URL="https://mail.daeroom.my.id"
DAEROOM_APP_SLUG="t"
DAEROOM_MAIL_API_KEY="your_daeroom_mail_api_key"
DAEROOM_MAIL_WEBHOOK_SECRET="your_daeroom_mail_webhook_secret"
DAEROOM_TELEGRAM_CHAT_ID="your_telegram_admin_chat_id"
NEXT_PUBLIC_APP_URL="https://your-domain.com"
